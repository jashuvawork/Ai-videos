# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aivideo

# Storage
STORAGE_PROVIDER=local
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_LOCAL_PATH=./uploads

# Redis (optional - in-memory queue when unset)
REDIS_URL=

# AI Providers: mock | openai | stability | runway | elevenlabs | etc.
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_VIDEO_PROVIDER=mock
AI_VOICE_PROVIDER=mock
AI_MUSIC_PROVIDER=mock

# Provider API Keys (server-side only)
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
VOICE_API_KEY=
MUSIC_API_KEY=
OPENAI_API_KEY=

# App
NODE_ENV=development
APP_URL=http://localhost:3000
DEV_USER_ID=dev-user-001

# Rendering
RENDER_FPS=30
RENDER_QUALITY=high
