# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aivideo

# Storage
STORAGE_PROVIDER=local
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_LOCAL_PATH=./uploads

# Redis (optional - in-memory queue when unset)
REDIS_URL=

# Built-in Studio stack (default) — no OpenAI / Runway / ElevenLabs required
# studio = template scripts + Pollinations images + FFmpeg motion + Edge TTS
AI_TEXT_PROVIDER=studio
AI_IMAGE_PROVIDER=studio
AI_VIDEO_PROVIDER=studio
# Default voice: edge (free) — auto-upgrades to elevenlabs when ELEVENLABS_API_KEY is set
AI_VOICE_PROVIDER=edge
AI_MUSIC_PROVIDER=studio

# Optional paid providers (only if you set keys)
# AI_TEXT_PROVIDER=openai
# AI_IMAGE_PROVIDER=dalle
# AI_VIDEO_PROVIDER=runway
# AI_VOICE_PROVIDER=elevenlabs

# Provider API Keys (server-side only)
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
RUNWAY_API_KEY=
GOOGLE_API_KEY=
KLING_API_KEY=
VOICE_API_KEY=
# AI_VOICE_PROVIDER=elevenlabs

# ElevenLabs — cinematic narration (set on server only, never commit real keys)
ELEVENLABS_API_KEY=
MUSIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=

# App
NODE_ENV=development
APP_URL=http://localhost:3000
# When UI/API is on Vercel but renders run on Railway, set to Railway backend URL
ASSETS_BASE_URL=
# Vercel frontend only — point all /api calls to Railway backend (required for aivideos-phi.vercel.app)
NEXT_PUBLIC_API_BASE_URL=
DEV_USER_ID=dev-user-001

# Rendering
RENDER_FPS=30
RENDER_QUALITY=high
